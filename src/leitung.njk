---
layout: base.njk
permalink: /leitung/
seitentitel: Musikalische Leitung
---
<div class="container">
  <h1 class="seitentitel">Musikalische Leitung</h1>
  <div class="personen">
    {% for person in collections.leitungSichtbar %}
    <article class="person">
      <img src="{{ person.data.foto }}" alt="Porträt {{ person.data.name }}" loading="lazy">
      <div>
        <h2>{{ person.data.name }}</h2>
        {{ person.content | safe }}
      </div>
    </article>
    {% endfor %}
  </div>
</div>
