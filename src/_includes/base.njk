<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if seitentitel %}{{ seitentitel }} – {% endif %}{{ site.titel }}</title>
  <link rel="icon" href="{{ '/images/favicon.png' }}">
  <link rel="stylesheet" href="{{ '/css/style.css' }}">
  <link rel="stylesheet" href="{{ '/css/theme.css' }}">
</head>
<body>
  <a class="skip" href="#inhalt">Zum Inhalt springen</a>
  <header class="kopf">
    <div class="container kopf-inner">
      <a class="logo" href="{{ '/' }}">
        {{ site.titel }}
      </a>
      <button type="button" class="menu-knopf" aria-expanded="false" aria-controls="hauptmenu" hidden>
        <span class="menu-icon" aria-hidden="true"></span><span class="menu-text">Menü</span>
      </button>
      <nav id="hauptmenu" aria-label="Hauptmenü">
        {% for item in site.navigation %}
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.titel }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>
  <script>
    // Hamburger-Menü auf schmalen Bildschirmen (ohne JavaScript bleibt das Menü einfach sichtbar)
    (function () {
      const kopf = document.querySelector(".kopf");
      const knopf = kopf.querySelector(".menu-knopf");
      kopf.classList.add("mit-js");
      knopf.hidden = false;
      function setze(offen) {
        knopf.setAttribute("aria-expanded", String(offen));
        kopf.classList.toggle("offen", offen);
      }
      knopf.addEventListener("click", () => setze(knopf.getAttribute("aria-expanded") !== "true"));
      // Schliessen bei Tipp ausserhalb oder Escape
      document.addEventListener("click", (e) => { if (!kopf.contains(e.target)) setze(false); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") { setze(false); } });
    })();
  </script>
  <main id="inhalt">
    {{ content | safe }}
  </main>
  <footer class="fuss">
    <div class="container fuss-inner">
      <div><h2>{{ kurs.ausgabe }}</h2><p>{{ kurs.termin }}</p></div>
      <div><h2>Kursort</h2><p><a href="{{ kurs.kursort_link }}" target="_blank" rel="noopener">{{ kurs.kursort }}</a></p></div>
      <div><h2>Kontakt</h2><p><a href="mailto:{{ kurs.kontakt_email }}">{{ kurs.kontakt_email }}</a></p></div>
    </div>
  </footer>
</body>
</html>
