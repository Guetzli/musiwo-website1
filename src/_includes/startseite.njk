---
layout: base.njk
---
<section class="intro">
  <div class="container intro-inner">
    <div class="intro-text">
      <p class="kicker">{{ kurs.ausgabe }}</p>
      <h1 class="intro-titel">{{ untertitel or titel }}</h1>
      <p class="intro-buttons">
        <a class="button" href="{{ '/anmeldung/' }}">Zur Anmeldung</a>
      </p>
    </div>

    <aside class="ticket" aria-label="Auf einen Blick">
      <p class="ticket-kopf">{{ kurs.ausgabe }}</p>
      <dl>
        <div><dt>Termin</dt><dd>{{ kurs.termin }}</dd></div>
        <div><dt>Ort</dt><dd><a href="{{ kurs.kursort_link }}" target="_blank" rel="noopener">{{ kurs.kursort }}</a></dd></div>
        <div><dt>Anmeldeschluss</dt><dd>{{ kurs.anmeldeschluss }}</dd></div>
      </dl>
    </aside>

    {% if titelbild %}
    <figure class="intro-bild">
      <img src="{{ titelbild }}" alt="">
    </figure>
    {% endif %}
  </div>
</section>

<div class="container">
  <p class="ornament" aria-hidden="true">✦</p>
  <div class="abschnitte">
    {{ content | abschnitte | safe }}
  </div>
</div>
